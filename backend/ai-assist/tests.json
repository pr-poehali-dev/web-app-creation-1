{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Missing action",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Market search by query",
      "method": "GET",
      "path": "/?action=market_search&q=SBER",
      "expectedStatus": 200
    },
    {
      "name": "Market quote by ticker",
      "method": "GET",
      "path": "/?action=market_quote&ticker=SBER",
      "expectedStatus": 200
    },
    {
      "name": "Market news by ticker",
      "method": "GET",
      "path": "/?action=market_news&ticker=SBER&name=Сбербанк",
      "expectedStatus": 200
    },
    {
      "name": "Market review without auth",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "market_review",
        "ticker": "SBER"
      },
      "expectedStatus": 400
    },
    {
      "name": "Assistant register short name",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "register",
        "name": "a",
        "pin": "1234"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Assistant login wrong",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "login",
        "name": "nonexistent_user_xyz",
        "pin": "1234"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Assistant chat without token",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "chat",
        "message": "Привет"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    }
  ]
}